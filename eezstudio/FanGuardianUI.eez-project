          "fileName": "actions.h",
          "template": "#ifndef EEZ_LVGL_UI_EVENTS_H\n#define EEZ_LVGL_UI_EVENTS_H\n\n//${eez-studio LVGL_INCLUDE}\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n//${eez-studio LVGL_ACTIONS_DECL}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /*EEZ_LVGL_UI_EVENTS_H*/"
        },
        {
          "objID": "0ed40281-5203-40a1-862c-0cb07f5752b8",
          "fileName": "vars.h",
          "template": "#ifndef EEZ_LVGL_UI_VARS_H\n#define EEZ_LVGL_UI_VARS_H\n\n#include <stdint.h>\n#include <stdbool.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n// enum declarations\n\n//${eez-studio FLOW_ENUMS}\n\n// Flow global variables\n\n//${eez-studio FLOW_GLOBAL_VARIABLES_ENUM}\n\n// Native global variables\n\n//${eez-studio LVGL_VARS_DECL}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /*EEZ_LVGL_UI_VARS_H*/"
        },
